# Lay 3 gia tri nay tai: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Khoa bi mat CHI dung o server (api/auth.js, api/delete-account.js), tuyet doi khong dua ra client.
# Co khoa nay thi: dang ky khong can tat "Confirm email", co ma khoi phuc / quen mat khau,
# kiem tra trung ten dang nhap, tu kich hoat tai khoan cu, va xoa tai khoan.
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key
